{
  "name": "laboratorio-fisica-2d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Laboratorio de física 2D interactivo para el navegador: cuerpos rígidos, fluidos, visualización y experimentos.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "oxlint src tests",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.20.0",
    "earcut": "^3.2.3",
    "pixi.js": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/earcut": "^3.0.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
